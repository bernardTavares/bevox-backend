{
  "name": "bevox-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Bevox domain backend (Fastify monolith) — PRD bevox-backend",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.1",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.db.json && tsc-alias -p tsconfig.build.json && tsc-alias -p tsconfig.db.json && node scripts/check-dist-aliases.mjs",
    "start": "node dist/index.js",
    "worker": "node dist/queue/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write --no-error-on-unmatched-pattern \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\" \"db/**/*.ts\"",
    "format:check": "prettier --check --no-error-on-unmatched-pattern \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\" \"db/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "migrate:generate": "drizzle-kit generate",
    "migrate:up": "tsx scripts/migrate.ts up",
    "migrate:down": "tsx scripts/migrate.ts down",
    "check-env": "tsx scripts/check-env.ts",
    "bootstrap:meta-api-tenants": "tsx scripts/bootstrap-meta-api-tenants.ts",
    "seed": "tsx scripts/seed.ts",
    "openapi:types": "openapi-typescript openapi/bevox-backend-v1.yaml -o src/types/api.ts",
    "openapi:check": "openapi-typescript openapi/bevox-backend-v1.yaml --output -"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^6.1.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.73.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.215.0",
    "@opentelemetry/resources": "^2.7.0",
    "@opentelemetry/sdk-node": "^0.215.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@sentry/node": "^10.50.0",
    "bcrypt": "^6.0.0",
    "bullmq": "5",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "5",
    "fastify-plugin": "^5.1.0",
    "ioredis": "^5.10.1",
    "jose": "^6.2.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.20.0",
    "pino": "9",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "stripe": "^22.1.1",
    "svix": "^1.45.0",
    "zod": "4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "20",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/ui": "^4.1.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.3",
    "testcontainers": "^11.14.0",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.21.0",
    "typescript": "5",
    "vitest": "4"
  }
}
