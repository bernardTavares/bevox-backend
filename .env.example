# bevox-backend — variáveis de ambiente
#
# Copie para .env (NUNCA commitar) e ajuste valores antes de subir o serviço.
# Referências: PRD bevox-backend §11/§12/§13.

# ----------------------------------------------------------------------------
# Runtime
# ----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Test-seam feature flag. When true, the Clerk auth + organization-scope
# plugins honor the `x-test-clerk-organization` / `x-test-claim-organization`
# request headers to inject a synthetic principal. ONLY for integration
# tests — NEVER set in any deployed environment. The env schema REJECTS
# truthy values when NODE_ENV=production (defense-in-depth).
TEST_AUTH_BYPASS_ENABLED=false

# ----------------------------------------------------------------------------
# PostgreSQL (dedicado ao bevox-backend)
# ----------------------------------------------------------------------------
DATABASE_URL=postgresql://bevox:bevox_dev_password@localhost:5432/bevox_backend

# ----------------------------------------------------------------------------
# Redis (dedicado — BullMQ)
# ----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ----------------------------------------------------------------------------
# Clerk — autenticação de usuários do produto (OAuth + webhooks Svix)
# JWKS para validar tokens Clerk; webhook secret para verificar Svix.
# ----------------------------------------------------------------------------
CLERK_JWKS_URL=
CLERK_WEBHOOK_SECRET=

# ----------------------------------------------------------------------------
# Staff auth — autenticação de staff Bevox (HS256, painel staff)
# ----------------------------------------------------------------------------
STAFF_JWT_SECRET=
STAFF_JWT_ACCESS_TTL=900
STAFF_REFRESH_TTL_DAYS=7
BCRYPT_COST=12

# ----------------------------------------------------------------------------
# Google Calendar (C2 — integração calendar provider)
# GOOGLE_TOKEN_ENC_KEY: base64 de 32 bytes — gere com: openssl rand -base64 32
# ----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_WEBHOOK_SECRET=
GOOGLE_TOKEN_ENC_KEY=
CALENDAR_OAUTH_SUCCESS_URL=http://localhost:3000/calendar/settings/google/success
# Base HTTPS pública e roteável que o Google deve alcançar p/ webhooks/OAuth
# callback; domínio verificado. Vazio em dev → fallback p/ HARNESS_CALLBACK_BASE_URL.
PUBLIC_API_BASE_URL=

# ----------------------------------------------------------------------------
# Payments (Stripe Connect — onboarding + reconciliação)
# STRIPE_WEBHOOK_SECRET: whsec_ do endpoint Connect-scoped ("Connected
# accounts") no dashboard Stripe — NÃO o endpoint da conta da plataforma.
# ----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLATFORM_ACCOUNT_ID=acct_...
STRIPE_CONNECT_CLIENT_ID=ca_...
PAYMENTS_RECONCILE_STALENESS_MINUTES=5
PAYMENTS_ONBOARDING_RETURN_URL=http://localhost:3000/settings/payments
# Payments P2 — secret do endpoint Stripe webhook PLATFORM-scoped
# (Dashboard: endpoint "Your account" cobrindo payment_intent.*/refund.*).
# Distinto de STRIPE_WEBHOOK_SECRET (P1, Connect-scoped, inalterado).
STRIPE_WEBHOOK_SECRET_PLATFORM=
# Janela do QR Pix em segundos (default Stripe 14400 = 4h).
PAYMENTS_PIX_EXPIRES_SECONDS=14400

# ----------------------------------------------------------------------------
# Observabilidade — todos opcionais em dev
# ----------------------------------------------------------------------------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=bevox-backend
