# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dev-debug.log
pnpm-debug.log*

# Dependency directories
node_modules/

# Build output
dist/
build/
*.tsbuildinfo
# Compiled JS must never live in the TS source trees (src/, db/, scripts/).
# Real build output goes to dist/ only.
src/**/*.js
src/**/*.js.map
db/**/*.js
db/**/*.js.map
scripts/**/*.js
scripts/**/*.js.map

# Test / coverage
coverage/
.vitest-cache/

# Env files (commitar só .env.example)
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test

# Editor / IDE
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS
.DS_Store
Thumbs.db

# Caches
.eslintcache
.cache/

# Claude Code (config versionado; só local/state ignorado)
.claude/settings.local.json
.claude/state/*
!.claude/state/.gitkeep

# TaskMaster — manter tasks no repo, ignorar artefatos voláteis
.taskmaster/reports/
.taskmaster/state.json

# Chaves locais de dev (NUNCA commitar)
*.pem
*.key
keys/
